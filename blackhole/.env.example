# Black Hole runtime
BLACK_HOLE_DATA_DIR=data
BLACK_HOLE_HOST=127.0.0.1
BLACK_HOLE_PORT=8787
# Required (16+ chars) only when BLACK_HOLE_HOST is not loopback.
BLACK_HOLE_ACCESS_TOKEN=

# Provider connection checks. Never commit real values.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest

CODE_ASTRA_API_KEY=
CODE_ASTRA_BASE_URL=
CODE_ASTRA_MODEL=
