name: Build Android release candidate (owner-signed)
run-name: Android release · ${{ inputs.source_ref }}

# Manual only. Produces an owner-signed release APK + App Bundle for ONE exact
# source SHA. Fails closed (no artifact) when the owner signing secrets are not
# configured; never falls back to debug signing. Does not deploy or publish.
on:
  workflow_dispatch:
    inputs:
      source_ref:
        description: Exact release candidate commit SHA (not a branch name)
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: yeno-android-release
  cancel-in-progress: false

jobs:
  release:
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    env:
      CI: 'true'
      CARGO_BUILD_JOBS: '2'
    defaults:
      run:
        working-directory: apps/controller
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
        with:
          ref: ${{ inputs.source_ref }}
          persist-credentials: false
      - name: Pin exact source revision
        id: source
        working-directory: .
        run: |
          test "$(git rev-parse HEAD)" = "${{ inputs.source_ref }}" || { echo "source_ref must be the exact commit SHA"; exit 1; }
          echo "sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: '24'
      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4.9.1
        with:
          distribution: temurin
          java-version: '17'
      - name: Versioning + signing readiness (presence only, no secret values)
        working-directory: .
        env:
          YENO_ANDROID_KEYSTORE_BASE64: ${{ secrets.YENO_ANDROID_KEYSTORE_BASE64 }}
          YENO_ANDROID_KEYSTORE_PASSWORD: ${{ secrets.YENO_ANDROID_KEYSTORE_PASSWORD }}
          YENO_ANDROID_KEY_ALIAS: ${{ secrets.YENO_ANDROID_KEY_ALIAS }}
          YENO_ANDROID_KEY_PASSWORD: ${{ secrets.YENO_ANDROID_KEY_PASSWORD }}
        run: node scripts/android-release.mjs check
      - name: Install locked runtime dependencies
        working-directory: .
        run: npm ci --prefix runtime --ignore-scripts --no-audit --no-fund
      - name: Install locked frontend dependencies
        run: npm ci --ignore-scripts --no-audit --no-fund
      - name: Verify core and controller logic
        working-directory: .
        run: npm --offline test
      - name: Build frontend
        run: npm run build
      - name: Set up Android command-line tools
        uses: android-actions/setup-android@40fd30fb8d7440372e1316f5d1809ec01dcd3699 # v4
        with:
          cmdline-tools-version: '12266719'
          packages: 'platform-tools'
          log-accepted-android-sdk-licenses: 'false'
      - name: Configure Android and Rust
        run: |
          sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0" "ndk;28.2.13676358"
          test -d "$ANDROID_HOME/ndk/28.2.13676358"
          echo "NDK_HOME=$ANDROID_HOME/ndk/28.2.13676358" >> "$GITHUB_ENV"
          echo "$ANDROID_HOME/build-tools/35.0.0" >> "$GITHUB_PATH"
          rustup toolchain install stable --profile minimal
          rustup default stable
          rustup target add aarch64-linux-android
      - name: Initialize Android project
        run: npm run tauri -- android init --ci --skip-targets-install
      - name: Bind release build to owner keystore (outside repo)
        working-directory: .
        env:
          YENO_ANDROID_KEYSTORE_BASE64: ${{ secrets.YENO_ANDROID_KEYSTORE_BASE64 }}
          YENO_ANDROID_KEYSTORE_PASSWORD: ${{ secrets.YENO_ANDROID_KEYSTORE_PASSWORD }}
          YENO_ANDROID_KEY_ALIAS: ${{ secrets.YENO_ANDROID_KEY_ALIAS }}
          YENO_ANDROID_KEY_PASSWORD: ${{ secrets.YENO_ANDROID_KEY_PASSWORD }}
        run: node scripts/android-release.mjs configure
      - name: Build ARM64 release APK
        run: npm run tauri -- android build --apk --target aarch64 --ci
      - name: Build release App Bundle
        run: npm run tauri -- android build --aab --target aarch64 --ci
      - name: Collect release artifacts + verify signer
        id: collect
        working-directory: .
        run: |
          set -euo pipefail
          apk="$(find apps/controller/src-tauri/gen/android/app/build/outputs/apk -name '*release*.apk' -not -name '*unsigned*' | head -n1)"
          aab="$(find apps/controller/src-tauri/gen/android/app/build/outputs/bundle -name '*release*.aab' | head -n1)"
          test -n "$apk" && test -n "$aab"
          apksigner verify --print-certs "$apk" | grep -v -i 'Android Debug'
          mkdir -p release-out
          cp "$apk" "release-out/blackhole-${{ steps.source.outputs.sha }}.apk"
          cp "$aab" "release-out/blackhole-${{ steps.source.outputs.sha }}.aab"
          (cd release-out && sha256sum *.apk *.aab > SHA256SUMS.txt)
          node -e '
            const fs=require("fs");const c=JSON.parse(fs.readFileSync("apps/controller/src-tauri/tauri.conf.json","utf8"));
            fs.writeFileSync("release-out/build-info.json",JSON.stringify({sourceCommit:process.env.SHA,versionName:c.version,versionCode:c.bundle.android.versionCode,identifier:c.identifier,workflowRun:process.env.GITHUB_RUN_ID,signing:"owner-keystore"},null,2));
          '
          cat release-out/SHA256SUMS.txt release-out/build-info.json
        env:
          SHA: ${{ steps.source.outputs.sha }}
      - name: Upload owner-signed release candidate
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: yeno-android-release-${{ steps.source.outputs.sha }}
          path: release-out/
          if-no-files-found: error
          retention-days: 14
