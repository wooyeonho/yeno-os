{
  "name": "yeno-os-runtime",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "YENO personal runtime: mobile control, durable jobs, memory and recovery",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node launch.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node ../scripts/blackhole-check.mjs --mode isolated",
    "check:core": "node ../scripts/blackhole-check.mjs --mode basic",
    "check:live": "node ../scripts/blackhole-check.mjs --mode live",
    "check:living-loop": "node ../scripts/verify-living-loop-live.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "qrcode": "1.5.4",
    "quantum-circuit": "0.9.251",
    "quickjs-emscripten": "0.32.0",
    "wilson-score-interval": "2.1.0"
  },
  "overrides": {
    "quantum-circuit": {
      "mathjs": "7.6.0"
    }
  }
}
