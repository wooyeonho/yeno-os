    {
      "op": "filter",
      "field": "evidenceCount",
      "operator": "lte",
      "value": 1
    },
    {
      "op": "sort",
      "field": "priority",
      "direction": "desc"
    },
    {
      "op": "limit",
      "count": 20
    }
  ],
  "output": {
    "title": "연구 근거의 다음 확인 항목",
    "description": "저장된 입력 기준으로 근거가 부족한 항목을 정리했습니다.",
    "columns": [
