        "field": "title",
        "label": "대상"
      },
      {
        "field": "evidenceCount",
        "label": "확인 근거 수"
      },
      {
        "field": "priority",
        "label": "확인 우선순위"
      },
      {
        "field": "nextStep",
        "label": "다음 확인"
      }
    ],
    "footer": "근거 수는 사실의 정확성이나 연구 효과를 증명하지 않습니다."
  },
